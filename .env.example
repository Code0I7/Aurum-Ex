# Copy this file to .env and adjust values before running `docker compose up`.

# --- Postgres ---
AURUM_POSTGRES_USER=aurum
AURUM_POSTGRES_PASSWORD=change-me
AURUM_POSTGRES_DB=aurum
AURUM_POSTGRES_HOST=db
AURUM_POSTGRES_PORT=5432

# --- Backend ---
# Comma-separated list of browser origins allowed to call the API. Leave it
# empty unless you serve the frontend from a different origin than the API:
# docker compose serves both from the same nginx, and the Vite dev server
# proxies /api, so neither needs this. "*" is honoured but then credentials
# are never granted, because "*" plus credentials lets any site you visit
# read this instance.
AURUM_CORS_ORIGINS=
AURUM_DEFAULT_CURRENCY=RUB

# --- Crypto tab (live prices via CoinGecko) ---
# Free Demo API key, no card required: coingecko.com/en/api/pricing. Leave
# blank and the Crypto tab's price sync just 400s with a message telling
# you to set this — nothing else in the app is affected.
AURUM_COINGECKO_API_KEY=

# --- Вход в приложение ---
# У Aurum-Ex есть собственная страница входа: одна учётная запись на всё
# домохозяйство, люди различаются участником в транзакции, а не логином.
# Пароль хранится в базе хешем (scrypt), не здесь.
AURUM_ADMIN_USERNAME=admin

# Пароль для первого запуска. Оставьте пустым — и приложение при первом
# открытии само попросит задать пароль в браузере; так он вообще не
# окажется в файле на диске. Если всё же заполняете, после первого старта
# значение отсюда стоит убрать: учётная запись уже создана.
AURUM_ADMIN_PASSWORD=

# Аварийный ключ для сброса ЗАБЫТОГО пароля — длинная случайная строка,
# которую знает только владелец сервера. Обычная смена пароля требует
# текущего; этот ключ единственный её обход, поэтому он живёт вне базы:
# доступ к чужой открытой вкладке им воспользоваться не позволяет.
# Пусто — сброс выключен целиком. Сгенерировать:
#   openssl rand -base64 48
AURUM_RECOVERY_KEY=

# Сколько часов живёт сессия без повторного входа. По умолчанию две недели.
AURUM_SESSION_TTL_HOURS=336

# Защита от перебора: сколько неудачных попыток подряд до блокировки и на
# сколько минут блокировать.
AURUM_MAX_FAILED_LOGINS=10
AURUM_LOCKOUT_MINUTES=15

# Ставить ли на куку сессии флаг Secure (передавать только по HTTPS).
# Выключено по умолчанию, иначе вход не работает на http://localhost.
# ВКЛЮЧИТЕ, когда публикуете экземпляр наружу за TLS.
AURUM_SECURE_COOKIES=false

# --- HTTP Basic Auth на nginx (необязательный второй слой) ---
# Достался от оригинального Aurum, где был единственной защитой. Теперь у
# приложения есть собственный вход, и это лишь дополнительный барьер перед
# ним — например, чтобы страница входа вообще не показывалась посторонним.
# Оставьте пустым, если не нужен.
AURUM_BASIC_AUTH_USER=
AURUM_BASIC_AUTH_PASSWORD=

# --- Ports exposed on your host machine ---
# Приложение слушает только на петле: наружу оно выходит через edge.
AURUM_WEB_PORT=3000

# --- Публикация наружу (сервис edge) ---
# Включается только тогда, когда в этом файле есть строка ниже. Без неё
# `docker compose up -d` поднимает три обычных контейнера и всё.
# COMPOSE_PROFILES=public

# Имя, на которое выпущен сертификат Let's Encrypt. Должно совпадать с
# каталогом в /etc/letsencrypt/live.
AURUM_DOMAIN=

# Порт, на котором отвечает TLS. Нестандартный, потому что 443 бывает уже
# занят чем-то другим на той же машине; браузер не ругается на порт, если
# сертификат настоящий.
AURUM_PUBLIC_PORT=48443

# Ключ калитки. Первый заход по ссылке https://ДОМЕН:ПОРТ/?k=КЛЮЧ кладёт
# куку на год, дальше работает обычная закладка. Смысл не в том, чтобы
# заменить пароль приложения, а в том, чтобы форма входа вообще не
# показывалась тому, кто просто нашёл домен.
#
# Сменить ключ можно в любой момент: новое значение сюда, перезапуск edge —
# и все старые куки и ссылки перестают действовать.
# Сгенерировать:  openssl rand -hex 16
AURUM_GATE_KEY=
